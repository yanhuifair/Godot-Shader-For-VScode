{
	"name": "godot-shader-for-vscode",
	"displayName": "Godot Shader For VSCode",
	"description": "The best Godot Shader development extension. 最佳的 Godot Shader 开发插件。",
	"version": "1.0.115",
	"license": "AGPL-3.0",
	"publisher": "FairYan",
	"icon": "images/logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/yanhuifair/Godot-Shader-For-VScode"
	},
	"bugs": {
		"url": "https://github.com/yanhuifair/Godot-Shader-For-VScode/issues"
	},
	"galleryBanner": {
		"color": "#478cbf",
		"theme": "dark"
	},
	"keywords": [
		"godot",
		"shader",
		"gdshader",
		"godot-shader",
		"glsl",
		"godotengine"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Programming Languages",
		"Formatters",
		"Snippets"
	],
	"activationEvents": [
		"onLanguage:godot-shader"
	],
	"main": "./out/extension",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "node auto-version.js && npm run vscode:prepublish && npx vsce package --no-dependencies",
		"publish": "npx vsce publish --no-dependencies"
	},
	"contributes": {
		"languages": [
			{
				"id": "godot-shader",
				"aliases": [
					"Godot Shader",
					"godot-shader"
				],
				"extensions": [
					".gdshader",
					".gdshaderinc"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "godot-shader",
				"scopeName": "source.gdshader",
				"path": "./syntaxes/godot-shader.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "godot-shader",
				"path": "./snippets/godot-shader.json"
			}
		],
		"configuration": {
			"title": "Godot Shader",
			"properties": {
				"godot-shader.general.language": {
					"type": "string",
					"default": "en",
					"enum": [
						"en",
						"zh"
					],
					"enumDescriptions": [
						"English prompts (default)",
						"中文提示"
					],
					"description": "Prompt language / 提示语言"
				},
				"godot-shader.diagnostics.checkBuiltinScope": {
					"type": "boolean",
					"default": true,
					"description": "Validate built-in variable scope per shader type / 检查内置变量使用范围"
				},
				"godot-shader.diagnostics.strictMode": {
					"type": "boolean",
					"default": false,
					"description": "Strict mode: extra warnings / 严格模式：额外警告"
				},
				"godot-shader.formatting.braceNewLine": {
					"type": "boolean",
					"default": false,
					"description": "Place opening brace on new line / 大括号另起一行"
				},
				"godot-shader.inlayHints.showParameterNames": {
					"type": "boolean",
					"default": true,
					"description": "Show parameter name hints when calling built-in functions / 调用内置函数时显示参数名提示"
				},
				"godot-shader.colorPicker.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show color picker for vec3/vec4/hex color values / 为颜色值显示颜色选择器"
				},
				"godot-shader.completion.autoImport": {
					"type": "boolean",
					"default": true,
					"description": "Suggest symbols from other .gdshaderinc files in the workspace and insert the matching #include automatically / 补全工作区其它 .gdshaderinc 中的符号，并在接受时自动插入 #include"
				},
				"godot-shader.trace.includeResolution": {
					"type": "boolean",
					"default": false,
					"description": "Log #include resolution to the Godot Shader output panel / 在输出面板打印 #include 解析过程（排查用）"
				},
				"godot-shader.paste.autoInclude": {
					"type": "boolean",
					"default": true,
					"description": "%config.paste.autoInclude%"
				},
				"godot-shader.inlineCompletions.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.inlineCompletions%"
				}
			}
		},
		"commands": [
			{
				"command": "godotShader.expandIncludes",
				"title": "%cmd.expandIncludes%",
				"category": "Godot Shader",
				"icon": "$(preview)"
			},
			{
				"command": "godotShader.switchShaderType",
				"title": "%cmd.switchShaderType%",
				"category": "Godot Shader",
				"icon": "$(symbol-namespace)"
			},
			{
				"command": "godotShader.insertTemplate",
				"title": "%cmd.insertTemplate%",
				"category": "Godot Shader",
				"icon": "$(file-code)"
			},
			{
				"command": "godotShader.showOutput",
				"title": "%cmd.showOutput%",
				"category": "Godot Shader",
				"icon": "$(output)"
			},
			{
				"command": "godotShader.reloadSymbols",
				"title": "%cmd.reloadSymbols%",
				"category": "Godot Shader",
				"icon": "$(refresh)"
			},
			{
				"command": "godotShader.refreshTree",
				"title": "%cmd.refreshTree%",
				"category": "Godot Shader",
				"icon": "$(refresh)"
			},
			{
				"command": "godotShader.revealLocation",
				"title": "%cmd.revealLocation%",
				"category": "Godot Shader"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "godotShader.expandIncludes",
					"when": "editorLangId == godot-shader",
					"group": "navigation@10"
				},
				{
					"command": "godotShader.switchShaderType",
					"when": "editorLangId == godot-shader",
					"group": "navigation@11"
				},
				{
					"command": "godotShader.insertTemplate",
					"when": "editorLangId == godot-shader",
					"group": "navigation@12"
				},
				{
					"command": "godotShader.showOutput",
					"when": "editorLangId == godot-shader",
					"group": "z_commands@1"
				}
			],
			"commandPalette": [
				{
					"command": "godotShader.expandIncludes",
					"when": "editorLangId == godot-shader"
				},
				{
					"command": "godotShader.switchShaderType",
					"when": "editorLangId == godot-shader"
				},
				{
					"command": "godotShader.insertTemplate",
					"when": "editorLangId == godot-shader"
				},
				{
					"command": "godotShader.refreshTree",
					"when": "view == godotShaderOutline"
				},
				{
					"command": "godotShader.revealLocation",
					"when": "false"
				},
				{
					"command": "godotShader.reloadSymbols"
				}
			],
			"view/title": [
				{
					"command": "godotShader.refreshTree",
					"when": "view == godotShaderOutline",
					"group": "navigation"
				}
			]
		},
		"keybindings": [
			{
				"command": "godotShader.expandIncludes",
				"key": "ctrl+alt+e",
				"mac": "cmd+alt+e",
				"when": "editorLangId == godot-shader"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "godot-shader",
				"scopes": {
					"variable": [
						"variable.other.readwrite.gdshader",
						"variable.other.gdshader"
					],
					"property": [
						"variable.other.property.gdshader",
						"support.variable.gdshader"
					],
					"function": [
						"entity.name.function.gdshader",
						"support.function.gdshader"
					],
					"keyword": [
						"keyword.control.gdshader",
						"keyword.other.gdshader"
					],
					"type": [
						"support.type.gdshader",
						"storage.type.gdshader"
					],
					"parameter": [
						"variable.parameter.gdshader"
					],
					"modifier": [
						"storage.modifier.gdshader",
						"entity.name.tag.gdshader"
					]
				}
			}
		],
		"configurationDefaults": {
			"[godot-shader]": {
				"editor.tabSize": 4,
				"editor.insertSpaces": true,
				"editor.detectIndentation": false,
				"editor.wordBasedSuggestions": "off",
				"editor.semanticHighlighting.enabled": true,
				"editor.bracketPairColorization.enabled": true,
				"editor.quickSuggestions": {
					"other": true,
					"comments": false,
					"strings": false
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "godot-shader-explorer",
					"title": "Godot Shader",
					"icon": "images/shader.svg"
				}
			]
		},
		"views": {
			"godot-shader-explorer": [
				{
					"id": "godotShaderOutline",
					"name": "%view.outline.name%",
					"icon": "images/shader.svg",
					"contextualTitle": "Godot Shader",
					"visibility": "visible"
				}
			]
		},
		"chatParticipants": [
			{
				"id": "godot-shader",
				"name": "shader",
				"fullName": "Godot Shader",
				"description": "%chat.description%",
				"isSticky": true,
				"commands": [
					{
						"name": "expand",
						"description": "%chat.cmd.expand%"
					},
					{
						"name": "uniforms",
						"description": "%chat.cmd.uniforms%"
					},
					{
						"name": "diagnostics",
						"description": "%chat.cmd.diagnostics%"
					},
					{
						"name": "docs",
						"description": "%chat.cmd.docs%"
					}
				]
			}
		],
		"walkthroughs": [
			{
				"id": "godotShaderGettingStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "open",
						"title": "%walkthrough.step.open.title%",
						"description": "%walkthrough.step.open.desc%",
						"media": {
							"markdown": "media/walkthrough-open.md"
						}
					},
					{
						"id": "includes",
						"title": "%walkthrough.step.includes.title%",
						"description": "%walkthrough.step.includes.desc%",
						"media": {
							"markdown": "media/walkthrough-includes.md"
						}
					},
					{
						"id": "commands",
						"title": "%walkthrough.step.commands.title%",
						"description": "%walkthrough.step.commands.desc%",
						"media": {
							"markdown": "media/walkthrough-commands.md"
						}
					}
				]
			}
		]
	},
	"devDependencies": {
		"@types/node": "^18.0.0",
		"@types/vscode": "1.100.0",
		"typescript": "^5.8.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "Include resolution and workspace indexing use the local file system; diagnostics, completion and navigation keep working."
		}
	},
	"markdown": "github",
	"qna": "marketplace"
}
